#!/bin/bash
./bin/docker-compose exec -T phpfpm bin/magento se:up && 
./bin/docker-compose exec -T phpfpm bin/magento se:di:co && 
./bin/docker-compose exec -T phpfpm bin/magento se:st:de -f && 
./bin/docker-compose exec -T phpfpm bin/magento indexer:reindex && 
./bin/docker-compose exec -T phpfpm bin/magento c:c && 
./bin/docker-compose exec -T phpfpm bin/magento c:f